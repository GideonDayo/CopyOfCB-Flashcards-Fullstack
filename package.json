{
  "devDependencies": {
    "concurrently": "^10.0.3"
  },
  "private": true,
  "workspaces": ["client", "server"],
  "scripts": {
    "dev": "concurrently \"cd client && npm run dev\" \"cd server && node index.js\"",
    "build": "npm run build -w=client",
    "start": "node server/index.js"
  }
}
